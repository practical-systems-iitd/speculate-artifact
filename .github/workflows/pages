  name: Deploy example_runs to Pages
  on:
    push:
      branches: [main]
      paths: [example_runs/**]
    workflow_dispatch:

  permissions:
    contents: read
    pages: write
    id-token: write

  jobs:
    deploy:
      environment:
        name: github-pages
        url: ${{ steps.deployment.outputs.page_url }}
      runs-on: ubuntu-latest
      steps:
        - uses: actions/checkout@v4
        - uses: actions/upload-pages-artifact@v3
          with:
            path: example_runs/
        - id: deployment
          uses: actions/deploy-pages@v4
